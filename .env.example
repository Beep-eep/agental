# Supabase connection. These two values are PUBLIC by design (the database is
# protected by Row Level Security), so they are safe in the browser and in git.
# Defaults below point at the shared `agental-demo` project. To use your own
# project, copy this file to .env.local and replace them
# (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://kpykhpnevgwlbaisrvpk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MINPhmoO42I_3eXOTRS5YA_l6wpnKto

# Public URL of this site (used for sign-up confirmation links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the service-role / secret key in this app.
