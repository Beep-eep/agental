# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Both values are safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of this site (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the service-role / secret key in this app. It is only needed by
# trusted back-office jobs (n8n, scripts), never by the website.
